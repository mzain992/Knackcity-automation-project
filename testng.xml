<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="KnackcityAppiumSuite" verbose="1">
    <test name="OnboardingTests">
        <classes>
            <class name="tests.OnboardingTest">
                <methods>
                    <include name="testNavigateToSignupViaNext"/>
                    <include name="testNavigateToSignupViaSkip"/>
                    <include name="testSignupWithEmailAndPassword"/>
                    <include name="testSignupWithCameraImageUpload"/>
                    <include name="testSignupWithGoogle"/>
                    <include name="testSignupDobValidation"/>
                    <include name="testNavigateToSignInFromSignup"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="SignInTests">
        <classes>
            <class name="tests.SignInTest">
                <methods>
                    <include name="testSignInWithValidCredentials"/>
                    <include name="testSignInWithInvalidEmailAndValidPassword"/>
                    <include name="testSignInWithValidEmailAndInvalidPassword"/>
                    <include name="testSignInWithInvalidEmailAndInvalidPassword"/>
                    <include name="testSignInWithUnregisteredEmail"/>
                    <include name="testSignInPasswordIsCaseSensitive"/>
                    <include name="testSignInWithEmptyEmailAndValidPassword"/>
                    <include name="testSignInWithValidEmailAndEmptyPassword"/>
                    <include name="testSignInWithBothFieldsEmpty"/>
                    <include name="testSignInWithMalformedEmailFormat"/>
                    <include name="testPasswordShowHideToggle"/>
                    <include name="testForgotPasswordNavigation"/>
                    <include name="testSignInWithGoogleFromWelcomeScreen"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
