<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Strictly sequential: there is exactly ONE physical device and ONE Appium session,
    so nothing here may run in parallel. parallel="none" + the thread counts below pin
    every test method AND every data-provider row to a single thread; two concurrent
    @BeforeMethod driver creations against one device fail with SessionNotCreatedException.
-->
<suite name="KnackcityAppiumSuite" verbose="1"
       parallel="none" thread-count="1" data-provider-thread-count="1">
    <test name="OnboardingTests">
        <classes>
            <class name="tests.OnboardingTest">
                <methods>
                    <include name="testNavigateToSignupViaNext"/>
                    <include name="testNavigateToSignupViaSkip"/>
                    <include name="testSignupWithEmailAndPassword"/>
                    <include name="testSignupWithCameraImageUpload"/>
                    <include name="testSignupWithGoogle"/>
                    <include name="testSignupDobValidation"/>
                    <include name="testNavigateToSignInFromSignup"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="ForgotPasswordTests">
        <classes>
            <class name="tests.ForgotPasswordTest">
                <methods>
                    <!--
                        End-to-end Forgot Password flow. Requires a human to type the OTP
                        on the device: the test waits out the 60s resend cooldown, then
                        polls for a manually-entered OTP (bounded by -DotpEntryWaitSeconds,
                        default 180s) before tapping Verify Code.
                    -->
                    <include name="testForgotPasswordEndToEndFlow"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="SignInTests">
        <classes>
            <class name="tests.SignInTest">
                <methods>
                    <!--
                        Single reusable method — the TestNG data provider runs it once per
                        Sign In entry point (Welcome screen, then Get Started screen), and
                        each run executes the full TC-01…TC-12 plan plus Forgot Password.
                    -->
                    <include name="executeSignInTestCases"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
